# AWS Credentials (para Claude - generación de prompts)
AWS_ACCESS_KEY_ID=tu_aws_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key_aqui

# fal.ai API Key (para FLUX - generación de imágenes)
